PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://user:password@localhost:5432/agrilearn
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="AgriLearn <no-reply@example.com>"
PASSWORD_RESET_URL=agrilearn:///reset-password
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=agrilearn-videos
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_MAX_VIDEO_BYTES=2147483648
R2_MULTIPART_THRESHOLD_BYTES=104857600
R2_MULTIPART_PART_SIZE_BYTES=16777216
